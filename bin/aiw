#!/usr/bin/env bash
# AI Terminal Workspace CLI Dispatcher

set -euo pipefail

VERSION="0.1.0"
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SCRIPTS_DIR="${PROJECT_ROOT}/scripts"

show_help() {
    cat << 'EOF'
aiw - AI Terminal Workspace CLI

Usage:
  aiw <command> [arguments]

Available Commands:
  help        Print usage information
  version     Print project version
  doctor      Execute environment preflight and dependency doctor checks
  config      Manage workspace and module configuration
  monitor     Monitor system telemetry (e.g., gpu)
  benchmark   Run LLM performance benchmarks
  report      Generate execution & telemetry reports
  workspace   Manage AI terminal workspace sessions

Options:
  -h, --help     Print usage information
  -v, --version  Print project version
EOF
}

show_version() {
    local git_commit git_date platform shell_name

    git_commit="$(git -C "${PROJECT_ROOT}" rev-parse --short HEAD 2>/dev/null || true)"
    if [[ -z "${git_commit}" ]]; then
        git_commit="unknown"
    fi

    git_date="$(git -C "${PROJECT_ROOT}" log -1 --format="%cs" 2>/dev/null || true)"
    if [[ -z "${git_date}" ]]; then
        git_date="unknown"
    fi

    platform="$(uname -s 2>/dev/null || echo "unknown")"

    shell_name="$(basename "${SHELL:-bash}" 2>/dev/null || echo "bash")"
    if [[ -z "${shell_name}" ]]; then
        shell_name="bash"
    fi

    echo "AI Terminal Workspace"
    echo ""
    echo "Version"
    echo "v${VERSION#v}"
    echo ""
    echo "Git Commit"
    echo "${git_commit}"
    echo ""
    echo "Build Date"
    echo "${git_date}"
    echo ""
    echo "Platform"
    echo "${platform}"
    echo ""
    echo "Shell"
    echo "${shell_name}"
}

dispatch() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local cmd="$1"
    shift

    case "${cmd}" in
        help|-h|--help)
            show_help
            ;;
        version|-v|--version)
            show_version
            ;;
        doctor|config|monitor|benchmark|report|workspace)
            local script="${SCRIPTS_DIR}/${cmd}.sh"
            if [[ -x "${script}" ]]; then
                exec "${script}" "$@"
            elif [[ -f "${script}" ]]; then
                exec bash "${script}" "$@"
            else
                echo "Error: Command script '${script}' not found." >&2
                exit 1
            fi
            ;;
        *)
            echo "Error: Unknown command '${cmd}'" >&2
            echo "" >&2
            show_help
            exit 1
            ;;
    esac
}

dispatch "$@"
